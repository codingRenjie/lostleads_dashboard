# ========== 使用说明 ==========
# 1. 复制本文件为项目根目录下的 `.env`（与 app 同级）：
#    cp .env.example .env
# 2. 在下方填入你的 Key；留空项不要删，填好后再启动 uvicorn。
#
# Kimi 使用 Moonshot 开放 API（与 OpenAI SDK 兼容）：
#   https://platform.moonshot.cn/
#
# 科大讯飞使用「语音听写（流式版）」WebSocket，控制台创建应用并开通该服务：
#   https://www.xfyun.cn/

# ---------- 大语言模型：Kimi（Moonshot）—— 战败表格抽取 + 批次数据分析 ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6

# ---------- 语音识别：科大讯飞（流式听写 WebSocket）----------
# 须与控制台一致：变量名必须是 IFLYTEK_APP_ID（不是 APPID）、IFLYTEK_API_KEY、IFLYTEK_API_SECRET。
# 控制台需添加「语音听写（流式版）」服务；若「剩余服务量」为 0，用量统计可能始终为 0，且无法识别。
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# 一般无需修改
IFLYTEK_IAT_URL=wss://iat-api.xfyun.cn/v2/iat

# ---------- 可选：不用讯飞时，改用 Whisper 兼容 ASR ----------
# 若已完整填写上方 IFLYTEK_*，可忽略本节。
# ASR_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1

# ---------- 性能（可选）----------
# 并行 ASR 路数；LLM_BATCH_SIZE>=2 时多条转写合并一次 Kimi 请求，=1 时逐条并行抽取
PIPELINE_MAX_WORKERS=4
LLM_BATCH_SIZE=4
# 讯飞每帧发送后休眠（秒）；若出现 10043 可改为 0.04
IFLYTEK_CHUNK_SLEEP_SEC=0.01

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./data/lost_leads.db
